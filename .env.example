# ─────────────────────────────────────────────────────────────────────────────
# Supabase Configuration
# Get these from: https://supabase.com/dashboard → Project → Settings → API
# Recommended region: Singapore (ap-southeast-1) for lowest Bangladesh latency
# ─────────────────────────────────────────────────────────────────────────────

# Project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (anon) key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Service role key — SERVER ONLY. NEVER expose in client bundle or public repo.
# Used for privileged server actions (admin verification, order linking RPC, etc.)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─────────────────────────────────────────────────────────────────────────────
# Transactional Email — Resend
# Get from: https://resend.com/api-keys
# Requires verified custom domain in https://resend.com/domains
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key

# Recipient email for new-order staff alerts
ADMIN_NOTIFICATION_EMAIL=orders@bashtoli.com

# Recipient email for customer product suggestions (optional; falls back to ADMIN_NOTIFICATION_EMAIL)
SUGGESTION_RECIPIENT_EMAIL=suggestions@bashtoli.com

# Verified sender email (optional; defaults to 'Bashtoli <orders@bashtoli.com>')
RESEND_FROM_EMAIL=Bashtoli <orders@bashtoli.com>

# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting — Upstash Redis
# Get from: https://console.upstash.com → Create Database → REST API
# Recommended region: Singapore (ap-southeast-1)
# Fails open gracefully in development if unset. Required in production.
# ─────────────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ─────────────────────────────────────────────────────────────────────────────
# Site URLs & Support
# ─────────────────────────────────────────────────────────────────────────────

# Canonical site URL (no trailing slash). Used for sitemaps, OpenGraph, and auth redirects.
NEXT_PUBLIC_APP_URL=https://bashtoli.com
NEXT_PUBLIC_SITE_URL=https://bashtoli.com

# WhatsApp Customer Care Contact (E.164 format without '+' or spaces, e.g. 8801825414737 for BD)
NEXT_PUBLIC_WHATSAPP_NUMBER=8801825414737

# ─────────────────────────────────────────────────────────────────────────────
# Security & Order Verification Cookies
# ─────────────────────────────────────────────────────────────────────────────
# Secret used for HMAC-SHA256 signing of guest order verification cookies.
# If unset, defaults to SUPABASE_SERVICE_ROLE_KEY.
ORDER_COOKIE_SECRET=
